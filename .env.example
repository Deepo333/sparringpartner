# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables (never commit real values).

# Postgres connection string (the Vercel Prisma Postgres integration sets this for you).
DATABASE_URL="postgres://..."

# Anthropic API key. Server-side only: never prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY="sk-ant-..."

# Optional. If set, the app asks for this code once per device before you can use it,
# so a stranger who finds your URL can't spend your API credits.
APP_ACCESS_CODE=""
